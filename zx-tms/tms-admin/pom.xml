<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.zxinfotek</groupId>
        <artifactId>zx-tms</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>tms-admin</artifactId>
    <name>tms-admin</name>
    <description>管理后台进程：HTTP 接口、权限 AOP、操作日志、定时任务</description>

    <dependencies>
        <dependency>
            <groupId>com.zxinfotek</groupId>
            <artifactId>tms-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zxinfotek</groupId>
            <artifactId>tms-activation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zxinfotek</groupId>
            <artifactId>tms-ota</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zxinfotek</groupId>
            <artifactId>tms-rki</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
